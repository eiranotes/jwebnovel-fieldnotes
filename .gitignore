# macOS
.DS_Store

# Private source and translation payloads (copyrighted/user-provided text)
workspace/**/source_inbox/
workspace/**/source/
workspace/**/merged/
workspace/**/translation/chunks/*/ja.txt
workspace/**/translation/chunks/*/ko.txt
workspace/**/translation/tasks/
workspace/**/parallel/
workspace/**/translation/output/
workspace/automation-logs/
workspace/private-console.*
private-viewer/

# Temporary/runtime files
.tmp/
*.tmp
__pycache__/
*.pyc
workspace/preference-feedback.json
workspace/preference-model.json
workspace/daily-taste-state.json
workspace/learning/

# Model outputs and runtime logs must never enter public history.
workspace/**/translation/results/
workspace/**/*.log
workspace/**/translation/parallel/
workspace/project-context/
workspace/automation-runs/
workspace/**/translation/commits/
workspace/**/translation/project-context.json
workspace/**/translation/project-run.lock
workspace/**/translation/project-result-*.json
workspace/**/translation/translation-result-*.json
workspace/**/translation/chunks/*/pairs.json
workspace/**/translation/chunks/*/pairs.txt
workspace/**/translation/.complete.lock
workspace/**/translation/*.lock

# Private preference evidence, revisions and locks (never public artifacts)
workspace/preference-ranking-traces.json
workspace/preference-learning-history.json
workspace/preference-evidence/
workspace/preference-revisions/
workspace/.preference.lock
workspace/preference-*.json.*.tmp

# Private discovery sampling / ranking evidence (may contain copyrighted excerpts or taste context)
workspace/**/review-samples/
workspace/**/candidates.json
workspace/**/rank-result.json
workspace/**/request.json
workspace/**/discovered-metadata.json
