{
  "schema_version": 2,
  "backend": "webgpt_project",
  "project_alias": "fieldnotes",
  "project_name": "Fieldnotes",
  "require_source_probe": true,
  "worker_reuse": "project_work_role",
  "worker_timeout_seconds": 600,
  "source_probe_max_attempts": 6,
  "source_probe_retry_seconds": 10,
  "fallback": {
    "enabled": true,
    "backend": "codex_webgpt",
    "timeout_seconds": 900,
    "trigger_codes": [
      "PROJECT_BRIDGE_UNAVAILABLE",
      "AUTOMATION_CAPABILITY_UNAVAILABLE",
      "PROJECT_TARGET_NOT_VERIFIED",
      "PROJECT_WORKER_BOOTSTRAP_FAILED",
      "PROJECT_SOURCE_UNAVAILABLE",
      "PROJECT_SOURCE_PROOF_MISMATCH",
      "PROJECT_SOURCE_UI_FAILED",
      "PROJECT_SOURCE_RECEIPT_MISMATCH",
      "PROJECT_INSTRUCTIONS_NOT_SAVED",
      "PROJECT_SYNC_OUTCOME_UNCERTAIN",
      "PROJECT_SYNC_RECEIPT_MISSING",
      "PROJECT_SYNC_PENDING",
      "INVALID_MODEL_JSON",
      "INVALID_TRANSLATION_RESULT",
      "LOCAL_SOURCE_PROOF_MISMATCH",
      "SEGMENT_COUNT_MISMATCH",
      "INVALID_SEGMENT_ROW",
      "SEGMENT_ID_ORDER_OR_EMPTY",
      "INVALID_GLOSSARY_UPDATE",
      "INVALID_GLOSSARY_BUCKET",
      "INVALID_GLOSSARY_ENTRY",
      "INVALID_GLOSSARY_DECISIONS",
      "GLOSSARY_CONFLICT"
    ]
  },
  "context_rollover_policy": "broker_context_ceiling",
  "activation": "verified_live"
}
